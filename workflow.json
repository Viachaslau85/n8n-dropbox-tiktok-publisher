      "id": "01ab8695-b2dc-4143-aadf-3fedc5687b18",
      "name": "Reserve row",
      "notes": "Write-ahead record: inserts status = pending BEFORE publishing. Prevents double posting on overlapping or crashed runs.",
      "notesInFlow": true
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "// Set only if several TikTok accounts are connected in Zernio; otherwise leave empty\nconst TIKTOK_USERNAME = '';\n\n// Accounts fetched once per run by the \"List accounts\" node\nconst accounts = $('List accounts').first().json.accounts || [];\n\nconst candidates = accounts.filter(a =>\n  a.platform === 'tiktok' &&\n  a.isActive &&\n  (!TIKTOK_USERNAME || a.username === TIKTOK_USERNAME)\n);\n\n// Fail fast instead of posting to the wrong account\nif (candidates.length === 0) {\n  throw new Error('No active TikTok account is connected in Zernio');\n}\nif (candidates.length > 1) {\n  throw new Error('Several TikTok accounts found: set TIKTOK_USERNAME in the \"Build request\" node');\n}\n\nconst ACCOUNT_ID = candidates[0]._id;\n\n// Caption variants. Replace with your own copy\nconst CAPTIONS = [\n  'Caption variant 1 #hashtag',\n  'Caption variant 2 #hashtag',\n  'Caption variant 3 #hashtag',\n  'Caption variant 4 #hashtag',\n  'Caption variant 5 #hashtag',\n];\n\n// Current video comes from the loop node\nconst video = $('One by one').item.json;\n\n// Random variant lowers the chance of duplicate-content rejections\nconst caption = CAPTIONS[Math.floor(Math.random() * CAPTIONS.length)];\n\n// $json is the \"Temp link\" response and holds the direct download URL\nreturn {\n  json: {\n    name: video.name,\n    dropboxPath: video.dropboxPath,\n    caption,\n    body: {\n      content: caption,\n      mediaItems: [{ type: 'video', url: $json.link }],\n      platforms: [{ platform: 'tiktok', accountId: ACCOUNT_ID }],\n      tiktokSettings: {\n        privacy_level: 'PUBLIC_TO_EVERYONE',\n        allow_comment: true,\n        allow_duet: true,\n        allow_stitch: true,\n        content_preview_confirmed: true,\n        express_consent_given: true,\n        draft: false,\n      },\n      publishNow: true,\n    },\n  },\n};"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1888,
        304
      ],
      "id": "f730da65-4de1-4905-84f3-d1f3576006f5",
      "name": "Build request",
      "notes": "Selects the TikTok account, picks a caption and assembles the request body.",
      "notesInFlow": true
    },
