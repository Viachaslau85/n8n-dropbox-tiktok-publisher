      "name": "List pack files",
      "credentials": {
        "dropboxOAuth2Api": {
          "name": "Dropbox account"
        }
      },
      "onError": "continueRegularOutput",
      "notes": "Lists every active pack folder. A missing folder yields an error item instead of aborting the other packs.",
