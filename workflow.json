    {
      "parameters": {
        "jsCode": "// File extensions treated as publishable video\nconst VIDEO_EXT = ['.mp4', '.mov'];\n\nconst result = [];\n\n// $input.all() returns every incoming item (files of all active packs)\nfor (const item of $input.all()) {\n  const f = item.json;\n\n  // Skip Dropbox error items, folders and non-video files\n  if (f.error) continue;\n  if (f.type !== 'file') continue;\n  const lower = (f.name || '').toLowerCase();\n  if (!VIDEO_EXT.some(ext => lower.endsWith(ext))) continue;\n\n  // Path layout: /<base>/<date>/<packCode>/<file>\n  const parts = f.pathDisplay.split('/');\n  const packCode = parts[parts.length - 2];\n  const folderDate = parts[parts.length - 3];\n\n  result.push({\n    json: {\n      name: f.name.replace(/\\.[^.]+$/, ''), // file name without extension\n      fileName: f.name,\n      dropboxPath: f.pathLower,              // idempotency key (case-insensitive path)\n      dropboxPathDisplay: f.pathDisplay,\n      packCode,\n      folderDate,\n      sizeBytes: f.contentSize,\n      modifiedAt: f.lastModifiedServer,\n    },\n  });\n}\n\n// Oldest upload first: deterministic publishing order\nresult.sort((a, b) => a.json.modifiedAt.localeCompare(b.json.modifiedAt));\n\nreturn result;"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        640,
        240
      ],
